# The tag archive IS the shipped plugin (the self-updater pulls archive/refs/tags/<tag>.zip;
# GitHub's archive endpoint respects export-ignore). Everything below is dev/CI-only and
# never belongs inside wp-content/plugins on a live install. Repo contents are unaffected.
# v9.42.0 (S2 §7): tests/ alone was 3.1 MB of the 7.6 MB tracked tree — bigger than inc/.
tests/            export-ignore
tools/            export-ignore
.github/          export-ignore
docs/             export-ignore
CHANGELOG.md      export-ignore
composer.json     export-ignore
composer.lock     export-ignore
phpstan-bootstrap.php export-ignore
phpstan.neon          export-ignore
phpstan-baseline.neon export-ignore
phpcs.xml.dist    export-ignore
.gitattributes    export-ignore
.gitignore        export-ignore
.gitleaks.toml    export-ignore
# lib/pdf ships its vendor/ (runtime Dompdf) but not the Composer files that built it.
lib/pdf/composer.json export-ignore
lib/pdf/composer.lock export-ignore
# 18.4.0: the résumé PDF sets Lato everywhere and uses DejaVu Sans only for the
# regular-weight ◆ bullet (inc/resume-pdf/template.php, .comp .dot: Lato has no
# U+25C6). The Bold / Oblique / BoldOblique DejaVu faces (~2.6 MB) never render.
lib/pdf/vendor/dompdf/dompdf/lib/fonts/DejaVuSans-Bold.*        export-ignore
lib/pdf/vendor/dompdf/dompdf/lib/fonts/DejaVuSans-Oblique.*     export-ignore
lib/pdf/vendor/dompdf/dompdf/lib/fonts/DejaVuSans-BoldOblique.* export-ignore
