<?xml version="1.0"?>
<ruleset name="Signal and Noise Tools — curated WP handbook conformance">
	<description>
		Curated WordPress-handbook ruleset: security (escaping/sanitization),
		direct-DB safety, deprecated/discouraged APIs, and PHP 8.0+ cross-version
		compatibility against the declared `Requires PHP` floor.

		Cosmetic/whitespace/Yoda/alignment sniffs are intentionally EXCLUDED — this
		is a private, single-author plugin with its own consistent tab style; the
		goal is correctness + security conformance, not WPCS formatting churn.

		Several architecturally-determined false-positive categories are excluded
		below with rationale. The high-value ERROR sniffs stay ACTIVE everywhere
		they aren't explicitly scoped out, so genuinely-unsafe future code still
		trips the alarm. Status as of 2026-05-29: 0 errors / 0 warnings.

		Run:  composer install, then composer run lint
		Fix:  composer run lint:fix   (whitespace-safe sniffs only)
	</description>

	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>
	<exclude-pattern>*/seed-content/*</exclude-pattern>
	<exclude-pattern>*/.git/*</exclude-pattern>
	<!-- .claude/ holds Claude session state + nested git worktrees (a FULL second
	     copy of inc/*.php). It MUST be excluded or PHPCS scans those duplicates
	     too. Anchored type="relative" (matched against basepath, not the absolute
	     path) so it only ever matches a `.claude/` at THIS repo's root — never a
	     `.claude/` ANCESTOR. A bare `*/.claude/*` matches absolute paths and would
	     silently exclude everything if this repo were itself checked out under a
	     `…/.claude/worktrees/…` path (the exact false-0/0 the theme hit). -->
	<exclude-pattern type="relative">^\.claude/</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="sp"/><!-- show sniff codes + progress -->

	<!-- ── Security: the load-bearing group (kept ACTIVE) ─────────────── -->
	<rule ref="WordPress.Security"/>

	<!--
		NonceVerification: EXCLUDED (whole plugin). All admin POST handling funnels
		through the central dispatcher sn_handle_admin_post() (inc/admin-post-handler.php
		since the v4.5.4 split; formerly admin-page.php), which calls
		check_admin_referer('sn_theme_options_nonce') ONCE before routing via the
		action→callback map to per-action handlers in inc/admin-post-actions.php.
		PHPCS can't follow that cross-function flow, so it flags every downstream
		$_POST/$_GET/$_FILES read as "no nonce" — but the nonce IS verified. The
		split kept the single shared-nonce design (one check before dispatch), so
		the cross-function limitation — and this exclusion — remain by design. The
		whole NonceVerification sniff (both .Recommended for reads and .Missing for
		writes, e.g. the v6.0.0 $_FILES CSV-import handler) is silenced for this
		reason.
	-->
	<rule ref="WordPress.Security.NonceVerification">
		<severity>0</severity>
	</rule>

	<!--
		EscapeOutput.OutputNotEscaped: scoped-EXCLUDED only in the admin RENDER
		files below. Every flagged value in these files is assembled from
		esc_attr__()/esc_url()/esc_html()'d fragments or literal HTML one–two lines
		above its echo (e.g. cron-dashboard $*_title via esc_attr__, dashboard $sep
		literal <span>, deploy $status_icon via the glyph helper). PHPCS only
		inspects the echo statement, not the assignment, so it can't see the
		pre-escaping; wrapping again would DOUBLE-escape (&middot; → &amp;middot;).
		All are manage_options-gated admin screens. The sniff stays ACTIVE on every
		other file. admin-tabs.php is here for its single $aria finding (a literal
		' aria-current="page"' fragment in sn_admin_render_sub_tabs()) — relocated
		from admin-page.php by the v4.5.4 split (which performed the "queued
		refactor" noted above); admin-page.php is now fully covered (no findings).
	-->
	<rule ref="WordPress.Security.EscapeOutput.OutputNotEscaped">
		<exclude-pattern>*/inc/admin-tabs.php</exclude-pattern>
		<exclude-pattern>*/inc/admin-tab-dashboard.php</exclude-pattern>
		<exclude-pattern>*/inc/cron-dashboard-admin.php</exclude-pattern>
		<exclude-pattern>*/inc/health-checks-admin.php</exclude-pattern>
		<exclude-pattern>*/inc/cloudflare-purge.php</exclude-pattern>
	</rule>

	<!--
		ValidatedSanitizedInput.InputNotSanitized: scoped-EXCLUDED only in the
		files below. Each flagged read is either (a) a $_SERVER value used solely
		in a comparison/parse — strpos / strtotime / in_array (allow-list) /
		filter_var(FILTER_VALIDATE_IP) / wp_parse_url — never stored unsanitized
		into a sink, or (b) a nonce value passed straight to wp_verify_nonce().
		All are wp_unslash()'d. Hand-verified in the v4.5.1 security audit + this
		pass. Sanitizing further would be a no-op (the value is validated by the
		comparison itself). The sniff stays ACTIVE on every other file.
	-->
	<rule ref="WordPress.Security.ValidatedSanitizedInput.InputNotSanitized">
		<exclude-pattern>*/inc/login-hide.php</exclude-pattern>
		<exclude-pattern>*/inc/seo.php</exclude-pattern>
		<exclude-pattern>*/inc/sitemap-redirect.php</exclude-pattern>
		<exclude-pattern>*/inc/post-settings.php</exclude-pattern>
		<exclude-pattern>*/inc/audit-log.php</exclude-pattern>
		<exclude-pattern>*/inc/rss-feed-tracker.php</exclude-pattern>
	</rule>

	<!--
		PreparedSQL: scoped-EXCLUDED only in the custom-table files + the
		insights/analytics readers. Those tables (wp_snt_cron_history,
		wp_rss_feed_log, wp_sn_analytics_daily, wp_sn_analytics_dims,
		wp_sn_analytics_utm, wp_sn_analytics_buckets, wp_sn_analytics_events,
		wp_sn_analytics_event_props, wp_sn_analytics_page_roles, wp_sn_edge_daily,
		wp_sn_edge_dims, wp_sn_schedules)
		have no WP API wrapper, so the table NAME must be
		interpolated ($wpdb->prefix . CONSTANT — never user input; identifiers
		cannot be bound by prepare()). Every VALUE is bound (%d/%s/%f) or
		integer-clamped. schedule-engine.php's delete_missing also interpolates a
		count-derived `%s, %s, ...` placeholder string into prepare() for the
		NOT IN (...) list — the placeholders are generated from the keep-list
		LENGTH only (never from its contents), and every keep value is bound as a
		%s arg, so no value reaches the query unprepared. Hand-verified in the
		v4.5.1 security audit + the v5.0.1 analytics-rollup/dims/read add + the
		v5.4.0 analytics-buckets add + the v6.2.0 analytics-events add + the
		v6.10.0 analytics-pageroles add + the v6.26.0 edge-rollup add + the
		v6.40.0 schedule-engine add + the v9.28.0 analytics-utm add (packed
		blob20 → wp_sn_analytics_utm; the sig-keyed upsert + the two GROUP BY
		reads interpolate only $wpdb->prefix . CONSTANT and bind every value).
		The sniff stays ACTIVE everywhere else.
	-->
	<rule ref="WordPress.DB.PreparedSQL">
		<exclude-pattern>*/inc/cron-history.php</exclude-pattern>
		<exclude-pattern>*/inc/rss-feed-tracker.php</exclude-pattern>
		<exclude-pattern>*/inc/insights.php</exclude-pattern>
		<exclude-pattern>*/inc/analytics-rollup.php</exclude-pattern>
		<exclude-pattern>*/inc/analytics-dims.php</exclude-pattern>
		<exclude-pattern>*/inc/analytics-utm.php</exclude-pattern>
		<exclude-pattern>*/inc/analytics-read.php</exclude-pattern>
		<exclude-pattern>*/inc/analytics-posts.php</exclude-pattern>
		<exclude-pattern>*/inc/analytics-buckets.php</exclude-pattern>
		<exclude-pattern>*/inc/analytics-events.php</exclude-pattern>
		<exclude-pattern>*/inc/analytics-pageroles.php</exclude-pattern>
		<exclude-pattern>*/inc/edge-rollup.php</exclude-pattern>
		<exclude-pattern>*/inc/schedule-engine.php</exclude-pattern>
	</rule>

	<!--
		DirectDatabaseQuery: EXCLUDED. The plugin owns two custom tables and runs
		diagnostic reads against core tables (health-checks). Direct $wpdb access
		is required and correct; the caching sub-sniff is noise for prune/insert
		maintenance paths.
	-->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<severity>0</severity>
	</rule>

	<!-- ── API hygiene: deprecated / discouraged / global-override / extract ─ -->
	<rule ref="WordPress.WP.DeprecatedFunctions"/>
	<rule ref="WordPress.WP.DeprecatedParameters"/>
	<rule ref="WordPress.WP.DeprecatedClasses"/>
	<rule ref="WordPress.WP.DiscouragedFunctions"/>
	<rule ref="WordPress.WP.GlobalVariablesOverride"/>
	<rule ref="WordPress.PHP.DontExtract"/>

	<!--
		I18n: EXCLUDED. i18n is a documented non-goal for this single-author tool
		(no Text Domain header; no translations will ever be produced — see the
		theme's matching stance in inc/setup.php). Strings remain wrapped in __()
		so i18n CAN be enabled later if the decision changes.
	-->

	<!-- ── PHP cross-version compatibility against the declared floor ──── -->
	<config name="testVersion" value="8.0-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- WP version floor used by the deprecated/discouraged sniffs. -->
	<config name="minimum_wp_version" value="6.4"/>
</ruleset>
