#!/usr/bin/env bash
#
# The factory's gate: the same checks CI applies, run in the job's worktree
# before any reviewer looks. Writes round-N/checks.md, whose first line is
# "PASS <head sha>" or "FAIL <head sha>", and round-N/checks.log.
#
# The branch under test does not get to supply its own judge: the sweep runs
# the BASE branch's tests/run.sh, and a change to that file, or a test that is
# deleted or renamed away, fails the gate outright.
#
# Usage: bash tools/factory/gate <job-id>
#
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
JOBS="${FACTORY_JOBS:-$HERE/jobs}"
J="$JOBS/${1:?job id}/job.json"
[ -f "$J" ] || { echo "factory: no job $1" >&2; exit 2; }
WT="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["worktree"])' "$J")"
RND="$JOBS/$1/round-$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["round"])' "$J")"
BASE="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["base"])' "$HERE/config.json")"
[ -d "$WT" ] || { echo "factory: job $1 has no worktree" >&2; exit 2; }
# A plain folder inside another checkout would answer git with that checkout.
TOP="$(git -C "$WT" rev-parse --show-toplevel 2>/dev/null)"
[ -n "$TOP" ] && [ "$(cd "$TOP" && pwd -P)" = "$(cd "$WT" && pwd -P)" ] || { echo "factory: $WT is not the top of a git worktree" >&2; exit 2; }
mkdir -p "$RND"; LOG="$RND/checks.log"; : > "$LOG"
cd "$WT"; SHA="$(git rev-parse HEAD)"; fails=()
TMP="$(mktemp -d)"; trap 'rm -f "$TMP/files" "$TMP/run.sh"; rmdir "$TMP"' EXIT

step() { # name, command...
	local name="$1"; shift
	echo "== $name" >> "$LOG"
	if "$@" >> "$LOG" 2>&1; then echo "- pass: $name"; else fails+=("$name"); echo "- FAIL: $name"; fi
}
d() { git diff --no-color --no-ext-diff --no-renames "$@"; }
clean_tree()  { [ -z "$(git status --porcelain)" ]; }
# Everything the checks read is captured once, each capture's exit status
# checked: a failed `git diff` fails the gate, and no early-exiting grep can
# turn a broken pipe into a pass. Paths go to a file, NUL-separated, so a
# quoted or non-ASCII name is still the name.
have_diff()   {
	git rev-parse -q --verify "origin/$BASE" >/dev/null && MB="$(git merge-base "origin/$BASE" HEAD)" \
	&& DIFF="$(d "$MB" HEAD)" && d -z --name-only --diff-filter=ACMR "$MB" HEAD > "$TMP/files" \
	&& GONE="$(d --name-only --diff-filter=D "$MB" HEAD -- tests/)" && RUNNER="$(d --name-only "$MB" HEAD -- tests/run.sh)" \
	&& TOUCHED="$(d --name-only --diff-filter=AM "$MB" HEAD -- tests/)" && git show "origin/$BASE:tests/run.sh" > "$TMP/run.sh"
}
php_lint()    { local bad=0 f; while IFS= read -r -d '' f; do case "$f" in *.php) echo "$f"; { [ -f "$f" ] && php -l "$f" >/dev/null; } || bad=1;; esac; done < "$TMP/files"; return $bad; }
# The bullets of the Unreleased section only: from its heading to the next "## ".
unreleased()  { awk '/^## \[Unreleased\]/{f=1;next} /^## /{f=0} f&&/^- /' | sort -u; }
changelog()   { local was now; was="$(git show "$MB:CHANGELOG.md" 2>/dev/null | unreleased)"; now="$(git show HEAD:CHANGELOG.md | unreleased)" || return 1
                [ -n "$(comm -13 <(echo "$was") <(echo "$now"))" ]; }
EMDASH=$'\xe2\x80\x94' # spelled in bytes, so this file passes its own check
# Added lines by position, not by pattern: after a file's header ends at its
# first "@@", every line that opens with "+" is added text, whatever follows.
added()       { awk '/^diff --git /{h=1;next} /^@@/{h=0;next} !h&&/^\+/' <<< "$DIFF"; }
no_emdash()   { local a; [ -n "$DIFF" ] && a="$(added)" && ! grep -q "$EMDASH" <<< "$a"; }
has_tests()   { [ -n "$TOUCHED" ]; } # added or modified: a deletion is not a test
tests_kept()  { echo "deleted: ${GONE:-none}; runner changed: ${RUNNER:-no}"; [ -z "$GONE" ] && [ -z "$RUNNER" ]; }
sweep()       { # core's HTML API, fetched once and shared by every job, as CI does
	local core="$JOBS/.wp-core"
	[ -d "$core/wp-includes/html-api" ] || bash tools/fetch-wp-test-core.sh "$core" || return 1
	# The base's runner, sourced under the name tests/run.sh so it finds the repository from $0 as usual.
	SNT_WP_HTML_API="$core/wp-includes/html-api" FACTORY_RUNNER="$TMP/run.sh" bash -c 'source "$FACTORY_RUNNER"' tests/run.sh
}

DIFF=""; MB=""; GONE=""; RUNNER=""; TOUCHED=""
if ! have_diff; then echo "FAIL $SHA" > "$RND/checks.md"; echo "- FAIL: cannot diff against origin/$BASE (fetch it)" | tee -a "$RND/checks.md"; exit 1; fi
RES="$( { step "the work is committed (clean tree)" clean_tree
          step "php -l on every changed PHP file" php_lint
          step "CHANGELOG has a new Unreleased bullet" changelog
          step "no em dash in added lines" no_emdash
          step "the change adds or modifies a file under tests/" has_tests
          step "tests/run.sh is unchanged and no test is deleted or renamed away" tests_kept
          step "tests/run.sh from origin/$BASE (the CI sweep)" sweep
          [ ${#fails[@]} -eq 0 ] && echo "VERDICT PASS" || echo "VERDICT FAIL"; } )"
V="$(echo "$RES" | sed -n 's/^VERDICT //p')"
{ echo "$V $SHA"; echo; echo "## Summary"; echo "$RES" | grep '^- '; echo; echo "Log: $LOG"; } > "$RND/checks.md"
cat "$RND/checks.md"
[ "$V" = PASS ]
