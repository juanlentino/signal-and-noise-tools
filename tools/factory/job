#!/usr/bin/env python3
"""The factory's state keeper. One job per issue labeled `factory`.

It holds each job's stage, refuses a move the table does not allow or whose
evidence file is missing, and performs every GitHub side effect, so the
orchestrating session never improvises them. See tools/factory/README.md.

Usage: job new <issue> | refresh <id> | advance <id> <stage>
       job escalate <id> <reason> | ready <id> | worktree <id> | status [<id>]
FACTORY_DRY=1 prints GitHub commands instead of running them. It is a test
seam: it refuses the real jobs folder (set FACTORY_JOBS elsewhere) and any
job a live run made, and FACTORY_OWNER_OK and FACTORY_ROOT are read only
under it. A live run refuses a job a dry run made.
"""
import os, sys

sys.dont_write_bytecode = True  # no __pycache__ in the checkout that runs this
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from jobkit import commands  # noqa: E402

commands.main(sys.argv[1:], __doc__)
